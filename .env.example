OPENROUTER_KEY=your_openrouter_api_key
GIGACHAT_KEY=
GIGACHAT_MODEL=GigaChat
GIGACHAT_URL=https://api.giga.chat/v1/chat/completions
GIGACHAT_VERIFY_SSL_CERTS=true
GIGACHAT_ROOT_CA_FILE=backend/certs/russian_trusted_root_ca.pem
GIGACHAT_SUB_CA_FILE=backend/certs/russian_trusted_sub_ca.pem
APP_ENV=development
LLM_PROVIDER=gigachat
POSTGRES_USER=careeradar
POSTGRES_PASSWORD=replace_with_a_random_database_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=careeradar
JWT_SECRET=replace_with_a_random_secret_at_least_48_characters
JWT_EXPIRE_MINUTES=480
AUTH_RATE_LIMIT_WINDOW_SECONDS=
AUTH_RATE_LIMIT_USERNAME_ATTEMPTS=
AUTH_RATE_LIMIT_IP_ATTEMPTS=
AUTH_FAILURE_DELAY_BASE_SECONDS=
AUTH_FAILURE_DELAY_MAX_SECONDS=
RESUME_UPLOAD_MAX_BYTES=
RESUME_DOCX_MAX_ENTRIES=
RESUME_DOCX_MAX_UNCOMPRESSED_BYTES=
RESUME_DOCX_MAX_COMPRESSION_RATIO=
RESUME_RETENTION_DAYS=
RESUME_CLEANUP_INTERVAL_MINUTES=

# Production deployment
DOMAIN=careeradar.example.com
LETSENCRYPT_DIR=/etc/letsencrypt
